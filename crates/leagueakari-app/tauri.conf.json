{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeagueAkari Plus",
  "version": "0.1.0",
  "identifier": "com.leagueakari.plus",
  "mainBinaryName": "leagueakari-plus",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-sidecars.ps1 -Release",
    "frontendDist": "../../apps/leagueakari-ui-prototype"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LeagueAkari Plus",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ddragon.leagueoflegends.com https://opgg-static.akamaized.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LeagueAkari Plus",
    "icon": ["icons/icon.ico"],
    "externalBin": ["../../target/release/leagueakari-probe"],
    "useLocalToolsDir": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
