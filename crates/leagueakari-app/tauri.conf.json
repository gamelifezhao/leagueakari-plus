{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeagueAkari Plus",
  "version": "0.1.0",
  "identifier": "com.leagueakari.plus",
  "mainBinaryName": "leagueakari-plus",
  "build": {
    "frontendDist": "../../apps/leagueakari-ui-prototype"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LeagueAkari Plus",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ddragon.leagueoflegends.com https://opgg-static.akamaized.net"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
